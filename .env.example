# Telegram API credentials (получите на https://my.telegram.org)
API_ID=
API_HASH=
SESSION_NAME=tg_music_session

# Webhook API для мобильного приложения (Android)
ENABLE_WEBHOOK=true
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8088
# WEBHOOK_SECRET: секретный токен для защиты от спама (любая случайная строка)
WEBHOOK_SECRET=

# Last.fm credentials (необязательно, если используется только Android-приложение)
# Свяжите Spotify с Last.fm на https://www.last.fm/settings/applications
LASTFM_API_KEY=
LASTFM_USERNAME=

# Настройки био

DEFAULT_BIO= # био которое будет когда музыка НЕ будет играть . 
CHECK_INTERVAL=5
MAX_BIO_LENGTH=70
